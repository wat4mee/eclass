<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eclass.notify</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/.venv/bin/python</string>
        <string>-u</string>
        <string>__ROOT__/notify.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__ROOT__</string>
    <!-- deadline reminders (24 h / 3 h) from the local database every 30 minutes; no eClass requests -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__ROOT__/data/logs/notify.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/data/logs/notify.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
